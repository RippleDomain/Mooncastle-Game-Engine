<Window
    x:Class="MooncastleEditor.GameProject.ProjectBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.GameProject"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Project Browser"
    Width="800"
    Height="600"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <ToggleButton
                x:Name="openProjectButton"
                Click="onToggleButton_Clicked"
                Content="Open Project"
                FontSize="32"
                IsChecked="True" />
            <ToggleButton
                x:Name="createProjectButton"
                Margin="30,0,0,0"
                Click="onToggleButton_Clicked"
                Content="Create Project"
                FontSize="32"
                IsChecked="False" />
        </StackPanel>
        <StackPanel
            x:Name="browserContent"
            Grid.Row="1"
            Orientation="Horizontal">
            <local:OpenProjectView x:Name="openProjectView" />
            <local:NewProjectView x:Name="newProjectView" />
        </StackPanel>
    </Grid>
</Window>
