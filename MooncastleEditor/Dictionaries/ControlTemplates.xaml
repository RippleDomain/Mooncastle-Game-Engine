                <ControlTemplate TargetType="{x:Type utl:ComponentView}">
                    <Expander
                        x:Name="expander"
                        Background="{DynamicResource Editor.Window.GrayBrush3}"
                        IsExpanded="True">
                        <Expander.Style>
                            <Style TargetType="{x:Type Expander}">
                                <Setter Property="Foreground" Value="{DynamicResource Editor.FontBrush}" />
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock FontWeight="Bold" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Expander.Header>
                        <ContentPresenter Margin="5" />
                    </Expander>
                    <ControlTemplate.Triggers>
