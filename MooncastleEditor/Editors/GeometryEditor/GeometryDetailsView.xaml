<UserControl
    x:Class="MooncastleEditor.Editors.GeometryDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:GeometryEditor}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Background="{DynamicResource Editor.Window.GrayBrush3}">
            <Expander
                Foreground="{DynamicResource Editor.FontBrush}"
                Header="Active LOD"
                IsExpanded="True">
                <ItemsControl AlternationCount="{Binding MeshRenderer.Meshes.Count}" ItemsSource="{Binding MeshRenderer.Meshes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Background="{DynamicResource Editor.Window.GrayBrush4}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1,0,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush3}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush2}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Height="96" Margin="5,0">
                                    <StackPanel
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <TextBlock Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat=Submesh {0}}" />
                                        <TextBlock Margin="5,0,0,0" Text="{Binding Name}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <CheckBox Click="OnHighlight_CheckBox_Click" IsChecked="{Binding IsHighlighted, Mode=OneWay}">
                                            <Run Foreground="{DynamicResource Editor.FontBrush}" Text="Highlight" />
                                        </CheckBox>
                                        <CheckBox Click="OnIsolate_CheckBox_Click" IsChecked="{Binding IsIsolated, Mode=OneWay}">
                                            <Run Foreground="{DynamicResource Editor.FontBrush}" Text="Isolate" />
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
