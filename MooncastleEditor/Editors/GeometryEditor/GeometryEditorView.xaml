<UserControl
    x:Class="MooncastleEditor.Editors.GeometryEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:MooncastleEditor.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=ed:GeometryEditor}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}" />
    </UserControl.Resources>
    <UserControl.DataContext>
        <ed:GeometryEditor />
    </UserControl.DataContext>
    <DockPanel Background="{DynamicResource Editor.Window.GrayBrush2}">
        <Border
            Height="32"
            Margin="0,0,0,1"
            VerticalAlignment="Top"
            Background="{DynamicResource Editor.Window.GrayBrush3}"
            DockPanel.Dock="Top">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.3"
                    ShadowDepth="0" />
            </Border.Effect>
            <StackPanel Margin="5,2" Orientation="Horizontal">
                <TextBlock Margin="0,0,5,0" Text="LOD: " />
                <Slider
                    x:Name="lodSlider"
                    Width="128"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding MaxLODIndex}"
                    Minimum="0"
                    TickFrequency="1"
                    TickPlacement="BottomRight"
                    Value="{Binding LodIndex}">
                    <Slider.Style>
                        <Style TargetType="{x:Type Slider}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaxLODIndex}" Value="0">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutoLOD}" Value="true">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>
                <TextBox
                    Width="32"
                    IsEnabled="{Binding Path=IsEnabled, ElementName=lodSlider}"
                    Text="{Binding Path=Value, ElementName=lodSlider}" />
                <TextBlock Margin="15,0,5,0" Text="Auto LOD" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding AutoLOD}" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="250" MaxWidth="400" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ed:GeometryDetailsView Tag="{Binding ElementName=geometryView}" />
            <GridSplitter
                Width="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource Editor.Window.GrayBrush1}" />
            <StackPanel
                Grid.Column="1"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource Editor.RedBrush}" Text="{Binding MeshRenderer.CameraPosition.X, StringFormat=G5}" />
                    <TextBlock
                        Margin="10,0"
                        Foreground="{DynamicResource Editor.BlueBrush}"
                        Text="{Binding MeshRenderer.CameraPosition.Y, StringFormat=G5}" />
                    <TextBlock Foreground="{DynamicResource Editor.GreenBrush}" Text="{Binding MeshRenderer.CameraPosition.Z, StringFormat=G5}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource Editor.OrangeBrush}" Text="{Binding MeshRenderer.Meshes[0].Positions.Count}" />
                    <TextBlock
                        Margin="10,0"
                        Foreground="{DynamicResource Editor.OrangeBrush}"
                        Text="{Binding MeshRenderer.Meshes[0].Indices.Count}" />
                </StackPanel>
            </StackPanel>
            <ed:GeometryView
                x:Name="geometryView"
                Grid.Column="1"
                DataContext="{Binding MeshRenderer}" />
        </Grid>
    </DockPanel>
</UserControl>
