<UserControl
    x:Class="MooncastleEditor.Editors.TextureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:MooncastleEditor.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mooncastle="clr-namespace:MooncastleEditor"
    xmlns:opt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    d:DataContext="{d:DesignInstance Type=ed:TextureEditor}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid
            x:Name="backgroundGrid"
            ClipToBounds="True"
            MouseRightButtonDown="OnGrid_Mouse_RBD"
            MouseRightButtonUp="OnGrid_Mouse_RBU"
            MouseWheel="OnGrid_Mouse_Wheel"
            PreviewMouseMove="OnGrid_Mouse_Move">
            <Grid.Background>
                <VisualBrush
                    opt:Freeze="True"
                    TileMode="Tile"
                    Viewport="0,0,200,200"
                    ViewportUnits="Absolute"
                    Visual="{StaticResource TiledGridBackground}" />
            </Grid.Background>
            <Grid.LayoutTransform>
                <ScaleTransform />
            </Grid.LayoutTransform>
            <Canvas IsHitTestVisible="False">
                <Border x:Name="imageBorder">
                    <Border.Background>
                        <ImageBrush
                            x:Name="textureBackground"
                            ImageSource="/MooncastleEditor;component/Resources/TextureEditor/tiles.png"
                            Opacity="0.5"
                            TileMode="Tile"
                            Viewport="0,0,64,64"
                            ViewportUnits="Absolute" />
                    </Border.Background>
                    <Border.Resources>
                        <mooncastle:ReciprocalConverter x:Key="reciprocalConverter" />
                        <ed:ArrayIndexToCubeFaceConverter x:Key="arrayIndexToCubeFaceConverter" />
                        <ed:ChannelSelector
                            x:Key="channelEffect"
                            Channels="{Binding Channels}"
                            Stride="{Binding Stride}" />
                        <ScaleTransform x:Key="scaleTransform" ScaleX="{Binding Path=ScaleFactor, RelativeSource={RelativeSource AncestorType={x:Type ed:TextureView}}, Converter={StaticResource reciprocalConverter}}" ScaleY="{Binding Path=ScaleFactor, RelativeSource={RelativeSource AncestorType={x:Type ed:TextureView}}, Converter={StaticResource reciprocalConverter}}" />
                        <Image
                            x:Key="singleImageView"
                            Effect="{StaticResource channelEffect}"
                            Source="{Binding SelectedSliceBitmap}" />
                        <Style x:Key="{x:Type Path}" TargetType="{x:Type Path}">
                            <Setter Property="Fill" Value="{DynamicResource Editor.OrangeBrush}" />
                            <Setter Property="Stroke" Value="#8f000000" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="StrokeLineJoin" Value="Round" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="-32" />
                        </Style>
                        <Style x:Key="gridStyle" TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="0">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="1">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="2">
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="3">
                                    <Setter Property="Grid.Row" Value="2" />
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="4">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="5">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="3" />
                                </DataTrigger>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard AutoReverse="True">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                        <Grid x:Key="cubeMapView">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Row="1"
                                Grid.Column="2"
                                Effect="{StaticResource channelEffect}"
                                Source="{Binding CubeMap.PositiveX}" />
                            <Image
                                Grid.Row="1"
                                Grid.Column="0"
                                Effect="{StaticResource channelEffect}"
                                Source="{Binding CubeMap.NegativeX}" />
                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                Effect="{StaticResource channelEffect}"
                                Source="{Binding CubeMap.PositiveY}" />
                            <Image
                                Grid.Row="2"
                                Grid.Column="1"
                                Effect="{StaticResource channelEffect}"
                                Source="{Binding CubeMap.NegativeY}" />
                            <Image
                                Grid.Row="1"
                                Grid.Column="1"
                                Effect="{StaticResource channelEffect}"
                                Source="{Binding CubeMap.PositiveZ}" />
                            <Image
                                Grid.Row="1"
                                Grid.Column="3"
                                Effect="{StaticResource channelEffect}"
                                Source="{Binding CubeMap.NegativeZ}" />
                            <Grid LayoutTransform="{StaticResource scaleTransform}" Style="{StaticResource gridStyle}">
                                <Path HorizontalAlignment="Left" Data="M0,0 L32,16 0,32 8,16 z" />
                                <Path HorizontalAlignment="Right" Data="M0,16 L32,0 24,16 32,32 z" />
                                <Path VerticalAlignment="Bottom" Data="M0,32 L16,0 32,32 16,24 z" />
                                <Path VerticalAlignment="Top" Data="M0,0 L16,8 32,0 16,32 z" />
                            </Grid>
                        </Grid>
                        <DataTemplate DataType="{x:Type ed:TextureEditor}">
                            <Grid>
                                <ContentPresenter x:Name="singleImagePresenter" Content="{StaticResource singleImageView}" />
                                <ContentPresenter
                                    x:Name="cubeMapPresenter"
                                    Content="{StaticResource cubeMapView}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Texture.IsCubeMap}" Value="True" />
                                        <Condition Binding="{Binding ViewAsCubeMap}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="singleImagePresenter" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="cubeMapPresenter" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </Border.Resources>
                    <ContentPresenter x:Name="textureImage" Content="{Binding}" />
                </Border>
            </Canvas>
        </Grid>
        <Border
            x:Name="zoomLabel"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            d:Opacity="1"
            Background="#50000000"
            CornerRadius="5"
            IsHitTestVisible="False"
            Opacity="0">
            <TextBlock
                Margin="10,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                d:Text="ZOOM 50%"
                FontFamily="Bahnschrift condensed"
                FontSize="32"
                Foreground="{DynamicResource Editor.FontBrush}"
                Text="{Binding Path=ScaleFactor, RelativeSource={RelativeSource AncestorType={x:Type ed:TextureView}}, StringFormat=ZOOM {0:p0}}" />
        </Border>
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            d:Visibility="Visible"
            Background="#50000000"
            CornerRadius="5"
            IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Done}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.0"
                                            Duration="0:0:2" />
                                        <ObjectAnimationUsingKeyFrames
                                            BeginTime="0:0:0"
                                            Storyboard.TargetProperty="Visibility"
                                            Duration="0:0:2">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                        <ObjectAnimationUsingKeyFrames
                                            BeginTime="0:0:0"
                                            Storyboard.TargetProperty="Visibility"
                                            Duration="0:0:0.1">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Margin="10,5"
                d:Text="LOADING..."
                FontFamily="Bahnschrift condensed"
                FontSize="32">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Done}">
                                <Setter Property="Text" Value="DONE." />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Importing}">
                                <Setter Property="Text" Value="IMPORTING..." />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Processing}">
                                <Setter Property="Text" Value="PROCESSING..." />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Loading}">
                                <Setter Property="Text" Value="LOADING..." />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Saving}">
                                <Setter Property="Text" Value="SAVING..." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="True"
                                    RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.0"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
