<UserControl
    x:Class="MooncastleEditor.Editors.TextureDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:content="clr-namespace:MooncastleEditor.Content"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mooncastle="clr-namespace:MooncastleEditor"
    xmlns:utl="clr-namespace:MooncastleEditor.Utilities"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:TextureSizeToStringConverter x:Key="textureSizeToStringConverter" />
        <mooncastle:BooleanToYesNoConverter x:Key="booleanToYesNoConverter" />
        <mooncastle:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
        <utl:DataSizeToStringConverter x:Key="dataSizeToStringConverter" />
        <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="5"
            Orientation="Horizontal">
            <StackPanel.Resources>
                <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Margin" Value="0,5" />
                </Style>
            </StackPanel.Resources>
            <StackPanel Width="100">
                <TextBlock Text="Name" />
                <TextBlock Text="Dimension" />
                <TextBlock Text="Size" />
                <TextBlock Text="Format" />
                <TextBlock Text="Import Date" />
                <TextBlock Text="Data Size" />
                <TextBlock Text="Mip Levels" />
                <TextBlock Text="Is Normal Map" />
                <TextBlock Text="Is HDR" />
            </StackPanel>
            <StackPanel>
                <TextBlock d:Text="NormalMapTexture" Text="{Binding Texture.FileName}" />
                <TextBlock d:Text="2D Texture" Text="{Binding Texture.TextureImportSettings.Dimension, Converter={StaticResource enumDescriptionConverter}}" />
                <TextBlock d:Text="1024 x 1024 (512 x 512)">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource textureSizeToStringConverter}">
                            <Binding Path="." />
                            <Binding Path="SelectedSliceBitmap" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock d:Text="BC7 (RGBA) High Quality" Text="{Binding Texture.FormatName}" />
                <TextBlock d:Text="02-Jul-23 13:37" Text="{Binding Texture.ImportDate, StringFormat=dd-MMM-yyyy HH:mm}" />
                <StackPanel d:Visibility="Visible" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSlice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock d:Text="32 MB" Text="{Binding DataSize, Converter={StaticResource dataSizeToStringConverter}}" />
                    <TextBlock Text=" (" />
                    <TextBlock d:Text="4 MB" Text="{Binding SelectedSlice.RawContent.LongLength, Converter={StaticResource dataSizeToStringConverter}}" />
                    <TextBlock Text=")" />
                </StackPanel>
                <TextBlock d:Text="12" Text="{Binding Texture.MipLevels}" />
                <TextBlock d:Text="Yes" Text="{Binding Texture.IsNormalMap, Converter={StaticResource booleanToYesNoConverter}}" />
                <TextBlock d:Text="No" Text="{Binding Texture.IsHDR, Converter={StaticResource booleanToYesNoConverter}}" />
            </StackPanel>
        </StackPanel>
        <Rectangle
            Grid.Row="1"
            Height="20"
            Margin="0,3,0,0"
            VerticalAlignment="Top"
            Fill="{DynamicResource Editor.Window.GrayBrush2}" />
        <Rectangle
            Grid.Row="1"
            Height="3"
            Margin="0,2,0,0"
            VerticalAlignment="Top"
            Fill="{DynamicResource Editor.Selected.BackgroundBrush}" />
        <Expander
            Grid.Row="1"
            Foreground="{DynamicResource Editor.FontBrush}"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock FontWeight="Bold" Text="Import settings" />
            </Expander.Header>
            <StackPanel Margin="5">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:AssetEditorState.Done}">
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <content:TextureImportSettingsView DataContext="{Binding ImportSettings}" />
                <StackPanel
                    Margin="0,25,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="96"
                        Margin="0,0,25,0"
                        Command="{Binding ReimportCommand}"
                        Content="Re-import" />
                    <Button
                        Width="96"
                        Command="{Binding SaveCommand}"
                        Content="Save"
                        IsEnabled="{Binding CanSaveChanges}" />
                </StackPanel>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
