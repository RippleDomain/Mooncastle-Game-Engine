<UserControl
    x:Class="MooncastleEditor.Editors.GeometryComponentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:MooncastleEditor.Utilities.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mooncastle="clr-namespace:MooncastleEditor"
    xmlns:vm="clr-namespace:MooncastleEditor.Components"
    d:DataContext="{d:DesignInstance Type={x:Type vm:MSGeometry}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}" />
        <DataTemplate DataType="{x:Type vm:MeshWithMaterial}">
            <Border
                MinHeight="96"
                Margin="0,1,0,0"
                CornerRadius="5">
                <Border.Resources>
                    <Style
                        x:Key="{x:Type TextBlock}"
                        BasedOn="{StaticResource LightTextBlockStyle}"
                        TargetType="{x:Type TextBlock}" />
                </Border.Resources>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush3}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush2}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border
                        Margin="1"
                        Background="{DynamicResource Editor.Window.GrayBrush1}"
                        CornerRadius="5"
                        DockPanel.Dock="Top">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Meshes.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type StackPanel}}}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel
                            Margin="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource Editor.Disabled.FontBrush}" Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat='{}{0}.'}" />
                            <TextBlock
                                Margin="5,0,0,0"
                                FontStyle="Italic"
                                Foreground="{DynamicResource Editor.Disabled.FontBrush}"
                                Text="{Binding MeshInfo.Name}" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <Border
                                Width="64"
                                Height="64"
                                BorderBrush="{DynamicResource Editor.Window.GrayBrush6}"
                                BorderThickness="2"
                                ClipToBounds="True"
                                CornerRadius="5">
                                <Border.Background>
                                    <VisualBrush Stretch="Fill">
                                        <VisualBrush.Visual>
                                            <Image Source="{Binding MeshInfo.Icon}" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="10,0">
                                <StackPanel.Resources>
                                    <Style
                                        x:Key="{x:Type TextBlock}"
                                        BasedOn="{StaticResource LightTextBlockStyle}"
                                        TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="Foreground" Value="Moccasin" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="{Binding MeshInfo.VertexCount, StringFormat=V: {0}}" />
                                <TextBlock Text="{Binding MeshInfo.IndexCount, StringFormat=I: {0}}" />
                                <TextBlock Text="{Binding MeshInfo.TriangleCount, StringFormat=T: {0}}" />
                                <TextBlock Text="{Binding Material.Name, StringFormat=M: {0}}" />
                            </StackPanel>
                        </StackPanel>
                        <Expander Margin="5" Background="{StaticResource Editor.Window.GrayBrush2}">
                            <Expander.Header>
                                <TextBlock
                                    Foreground="LavenderBlush"
                                    Opacity="0.7"
                                    Text="Applied Material" />
                            </Expander.Header>
                            <Border Height="50" Background="Red">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="Orange"
                                    Text="APPLIED MATERIAL VIEW" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LodWithMaterials}">
            <Grid Background="{DynamicResource Editor.Window.GrayBrush3}">
                <Grid.Resources>
                    <Style
                        x:Key="{x:Type TextBlock}"
                        BasedOn="{StaticResource LightTextBlockStyle}"
                        TargetType="{x:Type TextBlock}" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GeometryWithMaterials.LODs.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentControl}}}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Width="73" Text="Name" />
                        <TextBlock
                            d:Text="CharacterModel"
                            Foreground="{DynamicResource Editor.GreenBrush}"
                            Text="{Binding Name}" />
                    </StackPanel>
                    <StackPanel Margin="5,0,0,5" Orientation="Horizontal">
                        <TextBlock Width="73" Text="Threshold" />
                        <TextBlock
                            d:Text="12.34"
                            Foreground="{DynamicResource Editor.GreenBrush}"
                            Text="{Binding Threshold}" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl
                    Grid.Row="1"
                    AlternationCount="{Binding Meshes.Count}"
                    ItemsSource="{Binding Meshes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ctrl:ComponentView Header="Geometry">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,5"
                Orientation="Horizontal">
                <TextBlock Width="78" Text="Name" />
                <TextBlock
                    d:Text="CharacterModel"
                    Foreground="Moccasin"
                    Opacity="0.6"
                    Text="{Binding GeometryWithMaterials.Name}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="0,5,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Border
                            HorizontalAlignment="Left"
                            Drop="OnGeometry_Border_Drop"
                            MouseLeftButtonDown="OnGeometryBorder_Mouse_LBD"
                            Style="{DynamicResource DropBorderStyle}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding GeometryWithMaterials.Icon}" />
                            </Border.Background>
                        </Border>
                        <Border
                            BorderThickness="2"
                            CornerRadius="5"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush ImageSource="/Resources/TextureEditor/chess.png" />
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GeometryWithMaterials}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border>
                                <Border.Background>
                                    <VisualBrush Viewport="0.1,0.2,0.8,0.6" Visual="{StaticResource MultivalueTextBlock}" />
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <StackPanel
                        x:Name="meshInfoStackPanel"
                        Margin="10,0,0,0"
                        d:Visibility="Visible">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1" />
                                            <Condition Binding="{Binding GeometryWithMaterials.LODs[0].Meshes.Count}" Value="1" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Resources>
                            <Style
                                x:Key="{x:Type TextBlock}"
                                BasedOn="{StaticResource LightTextBlockStyle}"
                                TargetType="{x:Type TextBlock}">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="Foreground" Value="Moccasin" />
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="DataContext" Value="{Binding GeometryWithMaterials.LODs[0].Meshes[0]}" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock d:Text="V: 80085" Text="{Binding MeshInfo.VertexCount, StringFormat=V: {0}}" />
                        <TextBlock d:Text="I: 160170" Text="{Binding MeshInfo.IndexCount, StringFormat=I: {0}}" />
                        <TextBlock d:Text="T: 4044" Text="{Binding MeshInfo.TriangleCount, StringFormat=T: {0}}" />
                        <TextBlock d:Text="M: Material" Text="{Binding Material.Name, StringFormat=M: {0}}" />
                    </StackPanel>
                    <Border
                        Margin="10,0"
                        d:Visibility="Visible"
                        BorderBrush="{DynamicResource Editor.OrangeBrush}"
                        BorderThickness="2"
                        CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <Expander
                    Margin="0,5,0,0"
                    d:IsExpanded="True"
                    Background="{DynamicResource Editor.Window.GrayBrush2}"
                    Visibility="{Binding Visibility, ElementName=meshInfoStackPanel}">
                    <Expander.Header>
                        <TextBlock
                            Foreground="LavenderBlush"
                            Opacity="0.7"
                            Text="Applied Material" />
                    </Expander.Header>
                    <Border Height="50" Background="Red">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="Orange"
                            Text="APPLIED MATERIAL VIEW" />
                    </Border>
                </Expander>
            </StackPanel>

            <TabControl
                Grid.Row="2"
                Margin="-2,10,-2,-2"
                AlternationCount="{Binding GeometryWithMaterials.LODs.Count}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding GeometryWithMaterials.LODs}"
                SelectedIndex="0"
                SelectionChanged="OnTabControl_SelectionChanged">
                <TabControl.Style>
                    <Style TargetType="{x:Type TabControl}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1" />
                                    <Condition Binding="{Binding GeometryWithMaterials.LODs[0].Meshes.Count}" Value="1" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1">
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="{x:Type TabItem}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock MinWidth="18" Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, StringFormat='{}{0}'}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </ctrl:ComponentView>
</UserControl>
