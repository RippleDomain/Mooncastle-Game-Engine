<Window
    x:Class="MooncastleEditor.EnginePathDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Where's Mooncastle Engine?"
    Width="400"
    Height="250"
    ResizeMode="NoResize"
    Style="{StaticResource MooncastleDialogStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Border
        Margin="10"
        HorizontalAlignment="Stretch"
        Background="{DynamicResource Editor.Window.GrayBrush3}"
        CornerRadius="3">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.6"
                ShadowDepth="2" />
        </Border.Effect>
        <Grid Margin="32,0">
            <TextBlock
                x:Name="messageTextBlock"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="{DynamicResource Editor.RedBrush}"
                TextWrapping="Wrap" />
            <DockPanel>
                <TextBlock
                    Width="72"
                    Style="{StaticResource LightTextBlockStyle}"
                    Text="Engine path" />
                <TextBox x:Name="pathTextBox" />
            </DockPanel>
            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Button
                    Width="64"
                    Margin="32,0"
                    Click="OnOk_Button_Click"
                    Content="OK"
                    IsDefault="True" />
                <Button
                    Width="64"
                    Content="Cancel"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
