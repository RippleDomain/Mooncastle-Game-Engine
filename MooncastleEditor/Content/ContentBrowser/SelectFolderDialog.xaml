<Window
    x:Class="MooncastleEditor.Content.SelectFolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Select Folder"
    Width="800"
    Height="600"
    MinWidth="600"
    MinHeight="400"
    Foreground="{DynamicResource Editor.FontBrush}"
    Style="{StaticResource MooncastleDialogStyle}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <local:ContentBrowserView
            x:Name="contentBrowserView"
            AllowImport="False"
            FileAccess="Write"
            SelectionMode="Single" />
        <Border Grid.Row="1" Background="{DynamicResource Editor.Window.GrayBrush3}">
            <StackPanel
                Margin="10"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="96"
                    Click="OnSelectFolder_Button_Click"
                    Content="Select Folder"
                    IsDefault="True" />
                <Button
                    Width="96"
                    Margin="32,0,0,0"
                    Content="Cancel"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
