<Window
    x:Class="MooncastleEditor.Content.SaveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Save"
    Width="800"
    Height="600"
    MinWidth="600"
    MinHeight="400"
    Foreground="{DynamicResource Editor.FontBrush}"
    Style="{StaticResource MooncastleDialogStyle}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <local:ContentBrowserView
            x:Name="contentBrowserView"
            AllowDrop="False"
            FileAccess="Write"
            MouseDoubleClick="OnContentBrowser_Mouse_DoubleClick"
            SelectionMode="Single" />
        <Border Grid.Row="1" Background="{StaticResource Editor.Window.GrayBrush3}">
            <StackPanel>
                <DockPanel Margin="10">
                    <TextBlock Style="{StaticResource LightTextBlockStyle}" Text="File name:" />
                    <TextBox
                        x:Name="fileNameTextBox"
                        Margin="5,0,0,0"
                        Text="{Binding Path=SelectedItem.FileName, ElementName=contentBrowserView, Mode=OneWay}" />
                </DockPanel>
                <StackPanel
                    Margin="10,0,11,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="96"
                        Click="OnSave_Button_Click"
                        Content="Save"
                        IsDefault="True" />
                    <Button
                        Width="96"
                        Margin="32,0,0,0"
                        Content="Cancle"
                        IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
