<UserControl
    x:Class="MooncastleEditor.Content.ContentBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utl="clr-namespace:MooncastleEditor.Utilities"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <utl:DataSizeToStringConverter x:Key="dataSizeToStringConverter" />
        <Style x:Key="SmallIconStyle" TargetType="{x:Type Image}">
            <Setter Property="Source" Value="{Binding IconSmall}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Source" Value="pack://application:,,,/Resources/ContentBrowser/folder.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LargeIconStyle" TargetType="{x:Type Image}">
            <Setter Property="Source" Value="{Binding Icon}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Source" Value="pack://application:,,,/Resources/ContentBrowser/largeFolder.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridViewColumnHeaderGripper" TargetType="{x:Type Thumb}">
            <Setter Property="Canvas.Right" Value="-9" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="{Binding Path=ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush4}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush2}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.FontBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Grid SnapsToDevicePixels="true">
                            <Border
                                x:Name="HeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1">
                                <TextBlock
                                    x:Name="HeaderContent"
                                    Margin="0,0,0,1"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                    Text="{TemplateBinding Content}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Canvas>
                                <Thumb x:Name="PART_HeaderGripper" Style="{StaticResource GridViewColumnHeaderGripper}" />
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Editor.Window.GrayBrush4}" />
                                <Setter TargetName="PART_HeaderGripper" Property="Background" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Editor.Window.GrayBrush6}" />
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="HeaderContent" Property="Margin" Value="1,1,0,0" />
                            </Trigger>
                            <Trigger Property="Height" Value="Auto">
                                <Setter Property="MinHeight" Value="20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="OnGridViewColumnHeader_Click" />
            <Style.Triggers>
                <Trigger Property="Role" Value="Floating">
                    <Setter Property="Opacity" Value="0.4082" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                <Canvas Name="PART_FloatingHeaderCanvas">
                                    <Rectangle
                                        Width="{TemplateBinding ActualWidth}"
                                        Height="{TemplateBinding ActualHeight}"
                                        Fill="#FF000000"
                                        Opacity="0.4697" />
                                </Canvas>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                <Border
                                    x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Height" Value="Auto">
                                        <Setter Property="MinHeight" Value="20" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.FontBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="5,2,5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="true">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.5" Color="{DynamicResource Editor.Selected.BackgroundColor}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="{DynamicResource Editor.Selected.BackgroundBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true" />
                                    <Condition Property="Selector.IsSelectionActive" Value="false" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush4}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true" />
                                    <Condition Property="IsMouseOver" Value="true" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.5" Color="{DynamicResource Editor.Selected.BackgroundColor}" />
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnContent_Item_MouseDoubleClick" />
            <EventSetter Event="KeyDown" Handler="OnContent_Item_KeyDown" />
        </Style>
        <GridView x:Key="gridView">
            <GridViewColumn>
                <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Name" Tag="FileName" />
                </GridViewColumn.Header>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image
                                Width="18"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmallIconStyle}" />
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="5,2,0,2"
                                    VerticalAlignment="Center"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBox
                                    Margin="0,-2"
                                    Padding="2,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource TextBoxStyle_WithRename}"
                                    Tag="{Binding RenameCommand}"
                                    Text="{Binding FileName, UpdateSourceTrigger=Explicit, Mode=OneWay}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn>
                <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Date Modified" Tag="DateModified" />
                </GridViewColumn.Header>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock
                                Margin="5,2,0,2"
                                VerticalAlignment="Center"
                                Text="{Binding DateModified, StringFormat=dd-MMM-yy HH:mm:ss}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn DisplayMemberBinding="{Binding Size, Converter={StaticResource dataSizeToStringConverter}}">
                <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Size" Tag="Size" />
                </GridViewColumn.Header>
            </GridViewColumn>
        </GridView>
        <DataTemplate x:Key="tileTemplate">
            <StackPanel
                Width="96"
                Margin="-4,0,0,0"
                HorizontalAlignment="Center">
                <Border MinHeight="{StaticResource AssetIconWidth}">
                    <Image
                        Width="{StaticResource AssetIconWidth}"
                        Height="{StaticResource AssetIconWidth}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource LargeIconStyle}" />
                </Border>
                <Grid>
                    <TextBlock
                        MaxHeight="60"
                        Margin="2,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Editor.FontBrush}"
                        Text="{Binding FileName}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBox
                        Margin="0,-2"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource TextBoxStyle_WithRename}"
                        Tag="{Binding RenameCommand}"
                        Text="{Binding FileName, UpdateSourceTrigger=Explicit, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <local:PlainView x:Key="tileView" ItemTemplate="{StaticResource tileTemplate}">
            <local:PlainView.ItemContainerStyle>
                <Style BasedOn="{StaticResource ListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                    <EventSetter Event="MouseDoubleClick" Handler="OnContent_Item_MouseDoubleClick" />
                    <EventSetter Event="KeyDown" Handler="OnContent_Item_KeyDown" />
                </Style>
            </local:PlainView.ItemContainerStyle>
        </local:PlainView>
        <Style x:Key="ListViewToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.Window.GrayBrush4}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <Image
                                x:Name="image"
                                Width="16"
                                Opacity="0.8"
                                Source="pack://application:,,,/Resources/ContentBrowser/listView.png" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="image" Property="Source" Value="pack://application:,,,/Resources/ContentBrowser/tileView.png" />
                                <Setter TargetName="border" Property="ToolTip" Value="Tile view" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Editor.MouseOver.BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="contextMenu">
            <MenuItem Header="New">
                <MenuItem Click="OnCreateNewFolder" Header="Folder" />
                <Separator />
                <MenuItem Header="Texture" />
                <MenuItem Header="Material" />
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Editor.Window.GrayBrush2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ListView
            x:Name="folderListView"
            Grid.Row="1"
            ContextMenu="{StaticResource contextMenu}"
            IsTextSearchEnabled="True"
            ItemsSource="{Binding FolderContent}"
            TextSearch.TextPath="FileName">
            <ListView.Style>
                <Style TargetType="{x:Type ListView}">
                    <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush2}" />
                    <Setter Property="ListBox.BorderThickness" Value="0" />
                    <Setter Property="AllowDrop" Value="{Binding Path=AllowImport, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ContentBrowserView}}}" />
                    <Setter Property="View" Value="{StaticResource gridView}" />
                    <Setter Property="SelectionMode" Value="{Binding Path=SelectionMode, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ContentBrowserView}}}" />
                    <EventSetter Event="DragEnter" Handler="OnFolderContent_ListView_DragEnter" />
                    <EventSetter Event="SelectionChanged" Handler="OnFolderContent_ListView_SelectionChanged" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsChecked, ElementName=listViewToggle}" Value="False">
                            <Setter Property="View" Value="{StaticResource tileView}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
        </ListView>
        <Border
            x:Name="dropBorder"
            Grid.Row="1"
            d:Visibility="Visible"
            AllowDrop="{Binding Path=AllowDrop, ElementName=folderListView}"
            Background="Transparent"
            DragLeave="OnDropBorder_DragLeave"
            Drop="OnDropBorder_Drop"
            Visibility="Collapsed">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="filesDrop"
                        Grid.Row="0"
                        Background="Transparent" />
                    <Border
                        x:Name="cfgDrop"
                        Grid.Row="1"
                        Background="Transparent" />
                </Grid>
                <Border
                    Background="#66000000"
                    BorderBrush="{StaticResource Editor.OrangeBrush}"
                    BorderThickness="2"
                    CornerRadius="50"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#cc000000"
                        BorderBrush="{StaticResource Editor.OrangeBrush}"
                        BorderThickness="2"
                        CornerRadius="20">
                        <StackPanel>
                            <Border
                                x:Name="filesBorder"
                                Width="250"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                CornerRadius="16,16,0,0">
                                <TextBlock
                                    x:Name="filesText"
                                    Margin="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Bahnschrift condensed"
                                    FontSize="24"
                                    Foreground="{StaticResource Editor.FontBrush}"
                                    Text="Import Individual Files" />
                            </Border>
                            <Border
                                x:Name="cfgBorder"
                                Width="250"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                CornerRadius="0,0,16,16">
                                <TextBlock
                                    x:Name="cfgText"
                                    Margin="20"
                                    HorizontalAlignment="Center"
                                    FontFamily="Bahnschrift condensed"
                                    FontSize="24"
                                    Foreground="{StaticResource Editor.FontBrush}"
                                    Text="Configure Import Settings" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
            <Border.Triggers>
                <EventTrigger RoutedEvent="DragEnter" SourceName="filesDrop">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetName="filesBorder"
                                Storyboard.TargetProperty="Background.Color"
                                From="Transparent"
                                To="{StaticResource Editor.OrangeColor}"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="filesBorder"
                                Storyboard.TargetProperty="Background.Opacity"
                                From="0"
                                To="0.6"
                                Duration="0:0:0.2" />
                            <ColorAnimation
                                Storyboard.TargetName="filesText"
                                Storyboard.TargetProperty="Foreground.Color"
                                From="{StaticResource Editor.FontColor}"
                                To="White"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="DragLeave" SourceName="filesDrop">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetName="filesBorder"
                                Storyboard.TargetProperty="Background.Color"
                                From="{StaticResource Editor.OrangeColor}"
                                To="Transparent"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="filesBorder"
                                Storyboard.TargetProperty="Background.Opacity"
                                From="0.6"
                                To="0"
                                Duration="0:0:0.2" />
                            <ColorAnimation
                                Storyboard.TargetName="filesText"
                                Storyboard.TargetProperty="Foreground.Color"
                                From="White"
                                To="{StaticResource Editor.FontColor}"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="DragEnter" SourceName="cfgDrop">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetName="cfgBorder"
                                Storyboard.TargetProperty="Background.Color"
                                From="Transparent"
                                To="{StaticResource Editor.OrangeColor}"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="cfgBorder"
                                Storyboard.TargetProperty="Background.Opacity"
                                From="0"
                                To="0.6"
                                Duration="0:0:0.2" />
                            <ColorAnimation
                                Storyboard.TargetName="cfgText"
                                Storyboard.TargetProperty="Foreground.Color"
                                From="{StaticResource Editor.FontColor}"
                                To="White"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="DragLeave" SourceName="cfgDrop">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetName="cfgBorder"
                                Storyboard.TargetProperty="Background.Color"
                                From="{StaticResource Editor.OrangeColor}"
                                To="Transparent"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="cfgBorder"
                                Storyboard.TargetProperty="Background.Opacity"
                                From="0.6"
                                To="0"
                                Duration="0:0:0.2" />
                            <ColorAnimation
                                Storyboard.TargetName="cfgText"
                                Storyboard.TargetProperty="Foreground.Color"
                                From="White"
                                To="{StaticResource Editor.FontColor}"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>
        <Border VerticalAlignment="Top" Background="{DynamicResource Editor.Window.GrayBrush3}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.3"
                    ShadowDepth="0" />
            </Border.Effect>
            <DockPanel>
                <DockPanel Margin="5" DockPanel.Dock="Top">
                    <ToggleButton
                        x:Name="listViewToggle"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ListViewToggleButtonStyle}" />
                    <TextBox />
                </DockPanel>
                <StackPanel
                    x:Name="pathStack"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Editor.FontBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="3,1" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="MinWidth" Value="48" />
                            <Setter Property="MaxWidth" Value="128" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid SnapsToDevicePixels="True">
                                            <Border
                                                x:Name="borderSelected"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="1"
                                                SnapsToDevicePixels="True" />
                                            <ContentPresenter
                                                x:Name="contentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Focusable="False"
                                                RecognizesAccessKey="True"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White" />
                                                <Setter TargetName="borderSelected" Property="Background" Value="{DynamicResource Editor.Selected.BackgroundBrush}" />
                                                <Setter TargetName="borderSelected" Property="Opacity" Value="0.4" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="true">
                                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White" />
                                                <Setter TargetName="borderSelected" Property="Background" Value="{DynamicResource Editor.Selected.BackgroundBrush}" />
                                                <Setter TargetName="borderSelected" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="Click" Handler="OnPathStack_Button_Click" />
                        </Style>
                        <Style x:Key="{x:Type Path}" TargetType="{x:Type Path}">
                            <Setter Property="Margin" Value="0,3,0,0" />
                            <Setter Property="Data" Value="M0,0 L1.5,0 L4.5,3 L1.5,6 L0,6 L3,3 z" />
                            <Setter Property="Fill" Value="{DynamicResource Editor.FontBrush}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Resources>
                    <Image
                        Width="18"
                        Margin="5,0,0,2"
                        Source="pack://application:,,,/Resources/ContentBrowser/folder.png" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
