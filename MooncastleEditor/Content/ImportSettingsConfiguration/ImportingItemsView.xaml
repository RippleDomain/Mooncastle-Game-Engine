<UserControl
    x:Class="MooncastleEditor.Content.ImportingItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource Editor.Window.GrayBrush2}">
            <ItemsControl ItemsSource="{Binding Source={x:Static local:ImportingItemCollection.FilteredItems}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ImportingItem}">
                        <Grid
                            x:Name="itemGrid"
                            Margin="1"
                            Background="{DynamicResource Editor.Window.GrayBrush1}"
                            ClipToBounds="True">
                            <Rectangle
                                x:Name="statusBar"
                                Height="5"
                                Margin="96,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                d:Fill="{DynamicResource Editor.GreenBrush}">
                                <Rectangle.RenderTransform>
                                    <SkewTransform AngleX="35" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <TextBlock
                                x:Name="assetType"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                d:Text="TEXTURE"
                                FontFamily="Bahnschrift"
                                FontSize="10"
                                Foreground="#20ffffff">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="1.62" ScaleY="1" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <StackPanel Margin="5,5,5,2">
                                <TextBlock
                                    d:Text="DiffuseTexture.png"
                                    Foreground="{DynamicResource Editor.FontBrush}"
                                    Text="{Binding Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    d:Text="00:03:40"
                                    Foreground="{DynamicResource Editor.FontBrush}"
                                    Text="{Binding ImportDuration}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="statusText"
                                        Width="85"
                                        d:Text="Done." />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProgressMaximum}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            d:Text="9"
                                            Foreground="{DynamicResource Editor.FontBrush}"
                                            Text="{Binding ProgressValue}" />
                                        <TextBlock
                                            d:Text="/10"
                                            Foreground="{DynamicResource Editor.FontBrush}"
                                            Text="{Binding ProgressMaximum, StringFormat=/{0}}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="assetType" Property="Foreground" Value="{DynamicResource Editor.FontBrush}" />
                                <Setter TargetName="itemGrid" Property="Background" Value="Black" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ImportStatus.Importing}">
                                <Setter TargetName="statusText" Property="Text" Value="Importing..." />
                                <Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource Editor.BlueBrush}" />
                                <Setter TargetName="statusBar" Property="Fill" Value="{DynamicResource Editor.BlueBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ImportStatus.Succeeded}">
                                <Setter TargetName="statusText" Property="Text" Value="Done." />
                                <Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource Editor.GreenBrush}" />
                                <Setter TargetName="statusBar" Property="Fill" Value="{DynamicResource Editor.GreenBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ImportStatus.Failed}">
                                <Setter TargetName="statusText" Property="Text" Value="Failed!" />
                                <Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource Editor.RedBrush}" />
                                <Setter TargetName="statusBar" Property="Fill" Value="{DynamicResource Editor.RedBrush}" />
                                <Setter TargetName="itemGrid" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.1" Color="{DynamicResource Editor.RedColor}" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Asset.Type}" Value="{x:Static local:AssetType.Animation}">
                                <Setter TargetName="assetType" Property="Text" Value="ANIMATION" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Asset.Type}" Value="{x:Static local:AssetType.Audio}">
                                <Setter TargetName="assetType" Property="Text" Value="AUDIO" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Asset.Type}" Value="{x:Static local:AssetType.Material}">
                                <Setter TargetName="assetType" Property="Text" Value="MATERIAL" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Asset.Type}" Value="{x:Static local:AssetType.Mesh}">
                                <Setter TargetName="assetType" Property="Text" Value="MESH" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Asset.Type}" Value="{x:Static local:AssetType.Skeleton}">
                                <Setter TargetName="assetType" Property="Text" Value="SKELETON" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Asset.Type}" Value="{x:Static local:AssetType.Texture}">
                                <Setter TargetName="assetType" Property="Text" Value="TEXTURE" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </ScrollViewer>
</UserControl>
