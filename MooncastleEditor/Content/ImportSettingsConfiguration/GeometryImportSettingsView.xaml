<UserControl
    x:Class="MooncastleEditor.Content.GeometryImportSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:GeometryImportSettings}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="{x:Type TextBlock}"
            BasedOn="{StaticResource LightTextBlockStyle}"
            TargetType="{x:Type TextBlock}" />
    </UserControl.Resources>
    <UniformGrid VerticalAlignment="Top" Rows="7">
        <DockPanel VerticalAlignment="Center">
            <TextBlock Width="150" Text="Normals" />
            <ComboBox x:Name="normalsComboBox" SelectedIndex="{Binding CalculateNormals}">
                <ComboBoxItem Content="Import" />
                <ComboBoxItem Content="Calculate" />
            </ComboBox>
        </DockPanel>
        <DockPanel Margin="0,2" VerticalAlignment="Center">
            <TextBlock Width="150" Text="Tangents" />
            <ComboBox SelectedIndex="{Binding CalculateTangents}">
                <ComboBoxItem Content="Import" />
                <ComboBoxItem Content="Mikk TSpace" />
            </ComboBox>
        </DockPanel>
        <DockPanel VerticalAlignment="Center">
            <TextBlock Width="150" Text="Smoothing Angle" />
            <Slider
                x:Name="angleSlider"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                d:Value="65"
                IsSnapToTickEnabled="True"
                Maximum="180"
                Minimum="0"
                TickFrequency="1"
                Value="{Binding SmoothingAngle}" />
        </DockPanel>
        <DockPanel
            Margin="0,2"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock Width="150" Text="Import Embedded Textures" />
            <CheckBox
                Margin="-1,0,0,0"
                d:IsChecked="True"
                IsChecked="{Binding ImportEmbeddedTextures}" />
        </DockPanel>
        <DockPanel
            Margin="0,2"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock Width="150" Text="Import Animations" />
            <CheckBox
                Margin="-1,0,0,0"
                d:IsChecked="{x:Null}"
                IsChecked="{Binding ImportAnimations}" />
        </DockPanel>
        <DockPanel
            Margin="0,2"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock Width="150" Text="Reverse Handedness" />
            <CheckBox
                Margin="-1,0,0,0"
                d:IsChecked="{x:Null}"
                IsChecked="{Binding ReverseHandedness}" />
        </DockPanel>
        <DockPanel
            Margin="0,2"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock Width="150" Text="Coalesce Meshes" />
            <CheckBox
                Margin="-1,0,0,0"
                d:IsChecked="False"
                IsChecked="{Binding CoalesceMeshes}" />
        </DockPanel>
    </UniformGrid>
</UserControl>