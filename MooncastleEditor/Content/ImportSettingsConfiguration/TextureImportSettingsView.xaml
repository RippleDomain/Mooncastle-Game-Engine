<UserControl
    x:Class="MooncastleEditor.Content.TextureImportSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mooncastle="clr-namespace:MooncastleEditor"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <mooncastle:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
        <local:TextureDimensionToBooleanConverter x:Key="textureDimensionToBooleanConverter" />
        <Style
            x:Key="{x:Type TextBlock}"
            BasedOn="{StaticResource LightTextBlockStyle}"
            TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Editor.Disabled.FontBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <ObjectDataProvider
            x:Key="bcFormatEnumDataSource"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:BC_FORMAT" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="28" />
            <RowDefinition MinHeight="28" />
            <RowDefinition MinHeight="28" />
            <RowDefinition MinHeight="28" />
            <RowDefinition MinHeight="28" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Text="Dimension" />
        <WrapPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,5"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <RadioButton
                Margin="0,1,20,2"
                Content="1D"
                Foreground="{DynamicResource Editor.FontBrush}"
                GroupName="Dimension"
                IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=0}" />
            <RadioButton
                Margin="0,1,20,2"
                d:IsChecked="True"
                Content="2D"
                Foreground="{DynamicResource Editor.FontBrush}"
                GroupName="Dimension"
                IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=1}" />
            <RadioButton
                Margin="0,1,20,2"
                d:IsEnabled="False"
                Content="3D"
                Foreground="{DynamicResource Editor.FontBrush}"
                GroupName="Dimension"
                IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=2}" />
            <RadioButton
                Margin="0,1,20,2"
                Content="Cubemap"
                Foreground="{DynamicResource Editor.FontBrush}"
                GroupName="Dimension"
                IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=3}" />
            <StackPanel d:Visibility="Visible">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dimension}" Value="{x:Static local:TextureDimension.TextureCube}">
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PrefilterCubeMap}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Width="100" Text="Cubemap Size" />
                    <TextBox
                        Width="48"
                        Padding="0"
                        d:Text="1024"
                        Text="{Binding CubeMapSize}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100" Text="Mirror Cubemap" />
                    <CheckBox IsChecked="{Binding MirrorCubeMap}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100" Text="Prefilter" />
                    <CheckBox IsChecked="{Binding PrefilterCubeMap}" />
                </StackPanel>
            </StackPanel>
        </WrapPanel>
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="Mip Levels" />
        <Slider
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Center"
            IsMoveToPointEnabled="True"
            Maximum="{Binding Source={x:Static local:Texture.MaxMIPLevels}}"
            Minimum="0"
            SmallChange="1"
            TickFrequency="1"
            TickPlacement="BottomRight"
            Value="{Binding MipLevels}" />
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,5,0"
            Text="Compress" />
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Horizontal">
            <CheckBox
                x:Name="compressCheckBox"
                VerticalAlignment="Center"
                d:IsChecked="True"
                IsChecked="{Binding Compress}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Compress}" Value="True" />
                                    <Condition Binding="{Binding FormatIndex}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Margin="30,0,5,0" Text="Prefer BC7" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding PreferBC7}" />
            </StackPanel>
        </StackPanel>
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,20,0"
            Text="Output Format" />
        <Grid Grid.Row="3" Grid.Column="1">
            <TextBlock Text="{Binding OutputFormat, Converter={StaticResource enumDescriptionConverter}}" />
            <ComboBox
                x:Name="formatComboBox"
                VerticalAlignment="Center"
                ItemsSource="{Binding Source={StaticResource bcFormatEnumDataSource}, Converter={StaticResource enumDescriptionConverter}}"
                SelectedIndex="{Binding FormatIndex}"
                Visibility="{Binding Compress, Converter={StaticResource booleanToVisibilityConverter}}" />
        </Grid>
        <TextBlock
            x:Name="alphaTextBlock"
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,0,5,0"
            d:Visibility="Visible"
            Text="Alpha Threshold">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Compress}" Value="True" />
                                <Condition Binding="{Binding FormatIndex}" Value="1" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Slider
            Grid.Row="4"
            Grid.Column="1"
            VerticalAlignment="Center"
            LargeChange="0.1"
            Maximum="1"
            Minimum="0"
            Visibility="{Binding Path=Visibility, ElementName=alphaTextBlock}"
            Value="{Binding AlphaThreshold}" />
    </Grid>
</UserControl>