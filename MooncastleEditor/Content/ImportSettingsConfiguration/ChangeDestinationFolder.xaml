<UserControl
    x:Class="MooncastleEditor.Content.ChangeDestinationFolder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:AssetProxy}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:ContentSubfolderConverter x:Key="contentSubfolderConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,0,0,5"
            d:Text="Destination folder for file.ext is"
            Text="{Binding FileInfo.Name, StringFormat='Destination folder for {0} is'}"
            TextTrimming="CharacterEllipsis" />
        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
            BorderThickness="1"
            CornerRadius="3">
            <DockPanel Margin="5">
                <Button
                    Click="OnChangeDestinationFolder_Button_Click"
                    Content="Change"
                    DockPanel.Dock="Right" />
                <TextBlock
                    d:Text="/Meshes/TreeModels"
                    Text="{Binding DestinationFolder, Converter={StaticResource contentSubfolderConverter}}"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
