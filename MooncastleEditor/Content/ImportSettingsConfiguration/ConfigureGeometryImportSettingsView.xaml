<UserControl
    x:Class="MooncastleEditor.Content.ConfigureGeometryImportSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mooncastle="clr-namespace:MooncastleEditor"
    xmlns:utl="clr-namespace:MooncastleEditor.Utilities"
    d:DataContext="{d:DesignInstance Type={x:Type local:ConfigureImportSettings}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <mooncastle:IndexOfConverter x:Key="indexOfConverter" />
        <utl:DataSizeToStringConverter x:Key="dataSizeToStringConverter" />
        <Style
            x:Key="{x:Type TextBlock}"
            BasedOn="{StaticResource LightTextBlockStyle}"
            TargetType="{x:Type TextBlock}" />
        <Style
            x:Key="AlternateColorListBoxItemStyle"
            BasedOn="{StaticResource ListBoxItemStyle}"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource Editor.Window.GrayBrush1}" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Stroke" Value="{DynamicResource Editor.RedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style
            x:Key="RemoveButtonStyle"
            BasedOn="{StaticResource SimpleButton}"
            TargetType="{x:Type Button}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,2,2,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>
    <Grid d:DataContext="{d:DesignInstance Type={x:Type local:GeometryImportSettingsConfigurator}}" DataContext="{Binding GeometryImportSettingsConfigurator}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="250" />
            <ColumnDefinition MinWidth="300" />
            <ColumnDefinition Width="250" MinWidth="250" />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,5,0" Background="{DynamicResource Editor.Window.GrayBrush3}">
            <DockPanel Margin="10" Background="{DynamicResource Editor.Window.GrayBrush3}">
                <StackPanel
                    Margin="0,0,0,10"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Button
                        Width="64"
                        Click="OnImport_Button_Click"
                        Content="Import"
                        IsEnabled="{Binding GeometryProxies.Count}" />
                </StackPanel>
                <ListBox
                    x:Name="geometryListBox"
                    HorizontalContentAlignment="Stretch"
                    AllowDrop="True"
                    AlternationCount="2"
                    BorderBrush="{DynamicResource Editor.OrangeBrush}"
                    Drop="OnListBox_Drop"
                    ItemContainerStyle="{StaticResource AlternateColorListBoxItemStyle}"
                    ItemsSource="{Binding GeometryProxies}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedIndex="0"
                    SelectionMode="Extended">
                    <ListBox.Triggers>
                        <EventTrigger RoutedEvent="PreviewDragEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="BorderThickness"
                                        From="0"
                                        To="2"
                                        Duration="0:0:0" />
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="Margin"
                                        From="0"
                                        To="-2"
                                        Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="PreviewDragLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="BorderThickness"
                                        From="2"
                                        To="0"
                                        Duration="0:0:0" />
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="Margin"
                                        From="-2"
                                        To="0"
                                        Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Drop">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="BorderThickness"
                                        From="2"
                                        To="0"
                                        Duration="0:0:0" />
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="Margin"
                                        From="-2"
                                        To="0"
                                        Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ListBox.Triggers>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Background="Transparent"
                                ToolTip="{Binding FileInfo.DirectoryName}"
                                ToolTipService.InitialShowDelay="500">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource indexOfConverter}" StringFormat="{}{0}. ">
                                            <Binding Path="." />
                                            <Binding ElementName="geometryListBox" Path="DataContext.GeometryProxies" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,20,0"
                                    Foreground="{DynamicResource Editor.OrangeBrush}"
                                    Text="{Binding FileInfo.Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding FileInfo.LastWriteTime}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding FileInfo.Length, Converter={StaticResource dataSizeToStringConverter}}" />
                                <Button
                                    x:Name="removeButton"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    Click="OnRemove_Button_Click"
                                    Style="{StaticResource RemoveButtonStyle}"
                                    Visibility="Collapsed">
                                    <Button.Content>
                                        <Grid>
                                            <Line
                                                Style="{StaticResource RedLineStyle}"
                                                X1="1"
                                                X2="8"
                                                Y1="1.5"
                                                Y2="8.5" />
                                            <Line
                                                Style="{StaticResource RedLineStyle}"
                                                X1="1"
                                                X2="8"
                                                Y1="8.5"
                                                Y2="1.5" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="removeButton" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <TextBlock
            x:Name="dropText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            d:Visibility="Visible"
            FontFamily="Bahnschrift condensed"
            FontSize="24"
            Foreground="{DynamicResource Editor.Window.GrayBrush5}"
            IsHitTestVisible="False"
            Text="Drop Files Here">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=Items.Count, ElementName=geometryListBox}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <GridSplitter
            Width="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent" />
        <Border
            Grid.Column="1"
            Margin="0,0,5,0"
            Background="{DynamicResource Editor.Window.GrayBrush3}">
            <Grid
                d:DataContext="{d:DesignInstance Type={x:Type local:GeometryProxy}}"
                d:Visibility="Visible"
                DataContext="{Binding Path=SelectedItem, ElementName=geometryListBox}">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <Trigger Property="DataContext" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="10"
                    d:Text="Import settings for model.fbx"
                    FontSize="16"
                    Text="{Binding FileInfo.Name, StringFormat='Import settings for {0}'}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    x:Name="PLACEHODLDER"
                    Grid.Row="1"
                    Height="128"
                    Margin="10,0,10,28"
                    Background="DarkMagenta">
                    <TextBlock Text="THIS IS A PLACEHOLDER FOR" />
                    <TextBlock Text="GEOMETRY IMPORT SETTINGS." />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Button
                        Width="150"
                        Click="OnApplyToSelection_Button_Click"
                        Content="Apply to Selection" />
                    <Button
                        Width="150"
                        Margin="0,8"
                        Click="OnApplyToAll_Button_Click"
                        Content="Apply to All" />
                    <Button Width="150" Content="Set as Default" />
                </StackPanel>
            </Grid>
        </Border>
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent" />
        <Grid Grid.Column="2" Background="{DynamicResource Editor.Window.GrayBrush3}">
            <DockPanel Margin="10">
                <TextBlock
                    DockPanel.Dock="Top"
                    FontSize="16"
                    Text="Imported files" />
                <Border
                    x:Name="ANOTHER_PLACEHOLDER"
                    Margin="0,10,0,0"
                    Background="{DynamicResource Editor.Window.GrayBrush2}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>