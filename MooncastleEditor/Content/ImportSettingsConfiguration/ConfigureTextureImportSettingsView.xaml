<UserControl
    x:Class="MooncastleEditor.Content.ConfigureTextureImportSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utl="clr-namespace:MooncastleEditor.Utilities"
    d:DataContext="{d:DesignInstance Type={x:Type local:ConfigureImportSettings}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <AlternationConverter x:Key="alternationConverter">
            <SolidColorBrush Color="Transparent" />
            <SolidColorBrush Color="{DynamicResource Editor.Window.GrayColor1}" />
        </AlternationConverter>
        <utl:DataSizeToStringConverter x:Key="dataSizeToStringConverter" />
        <Style
            x:Key="{x:Type TextBlock}"
            BasedOn="{StaticResource LightTextBlockStyle}"
            TargetType="{x:Type TextBlock}" />
        <Style
            x:Key="AlternateColorListBoxItemStyle"
            BasedOn="{StaticResource ListBoxItemStyle}"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}, Converter={StaticResource alternationConverter}}" />
        </Style>
        <Style x:Key="RedLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Stroke" Value="{DynamicResource Editor.RedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style
            x:Key="RemoveButtonStyle"
            BasedOn="{StaticResource SimpleButton}"
            TargetType="{x:Type Button}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,2,2,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ArrowPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Margin" Value="5,10" />
            <Setter Property="Fill" Value="{DynamicResource Editor.FontBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Fill" Value="{DynamicResource Editor.Disabled.FontBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ImageSourceListBoxItemTemplate">
            <Grid
                Background="Transparent"
                ToolTip="{Binding FileInfo.DirectoryName}"
                ToolTipService.InitialShowDelay="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, StringFormat='{}{0}. '}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    Foreground="{DynamicResource Editor.FontBrush}"
                    Text="{Binding FileInfo.Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding FileInfo.LastWriteTime}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding FileInfo.Length, Converter={StaticResource dataSizeToStringConverter}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid d:DataContext="{d:DesignInstance Type={x:Type local:TextureImportSettingsConfigurator}}" DataContext="{Binding TextureImportSettingsConfigurator}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="250" />
            <ColumnDefinition MinWidth="300" />
            <ColumnDefinition Width="250" MinWidth="250" />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,5,0" Background="{DynamicResource Editor.Window.GrayBrush3}">
            <DockPanel Margin="10" Background="{DynamicResource Editor.Window.GrayBrush3}">
                <StackPanel
                    Margin="0,0,0,10"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Button
                        Width="64"
                        Click="OnImport_Button_Click"
                        Content="Import"
                        IsEnabled="{Binding TextureProxies.Count}" />
                </StackPanel>
                <ListBox
                    x:Name="textureListBox"
                    HorizontalContentAlignment="Stretch"
                    AllowDrop="True"
                    AlternationCount="{Binding TextureProxies.Count}"
                    BorderBrush="{DynamicResource Editor.FontBrush}"
                    Drop="OnListBox_Drop"
                    ItemContainerStyle="{StaticResource AlternateColorListBoxItemStyle}"
                    ItemsSource="{Binding TextureProxies}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedIndex="0"
                    SelectionMode="Extended">
                    <ListBox.Triggers>
                        <EventTrigger RoutedEvent="PreviewDragEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="BorderThickness"
                                        From="0"
                                        To="2"
                                        Duration="0:0:0" />
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="Margin"
                                        From="0"
                                        To="-2"
                                        Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="PreviewDragLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="BorderThickness"
                                        From="2"
                                        To="0"
                                        Duration="0:0:0" />
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="Margin"
                                        From="-2"
                                        To="0"
                                        Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Drop">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="BorderThickness"
                                        From="2"
                                        To="0"
                                        Duration="0:0:0" />
                                    <ThicknessAnimation
                                        Storyboard.TargetProperty="Margin"
                                        From="-2"
                                        To="0"
                                        Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ListBox.Triggers>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Background="Transparent"
                                ToolTip="{Binding FileInfo.DirectoryName}"
                                ToolTipService.InitialShowDelay="500">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="hasImagesBorder"
                                    Grid.Row="0"
                                    Grid.RowSpan="4"
                                    Grid.Column="0"
                                    Width="5"
                                    Margin="0,0,5,0"
                                    Background="{DynamicResource Editor.GreenBrush}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageSources.Count}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, StringFormat='{}{0}. '}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,20,0"
                                    Foreground="{DynamicResource Editor.FontBrush}"
                                    Text="{Binding FileInfo.Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding FileInfo.LastWriteTime}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding FileInfo.Length, Converter={StaticResource dataSizeToStringConverter}}" />
                                <Expander
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5,0,0"
                                    Focusable="False"
                                    Visibility="{Binding Path=Visibility, ElementName=hasImagesBorder}">
                                    <Expander.Header>
                                        <TextBlock
                                            FontWeight="Bold"
                                            Style="{StaticResource LightTextBlockStyle}"
                                            Text="SOURCE IMAGES" />
                                    </Expander.Header>
                                    <ItemsControl Margin="23,5,0,10" ItemsSource="{Binding ImageSources}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,0,20,0"
                                                    Foreground="{DynamicResource Editor.FontBrush}"
                                                    Text="{Binding FileInfo.Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <Button
                                    x:Name="removeButton"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    Click="OnRemove_Button_Click"
                                    Style="{StaticResource RemoveButtonStyle}"
                                    Visibility="Collapsed">
                                    <Button.Content>
                                        <Grid>
                                            <Line
                                                Style="{StaticResource RedLineStyle}"
                                                X1="1"
                                                X2="8"
                                                Y1="1.5"
                                                Y2="8.5" />
                                            <Line
                                                Style="{StaticResource RedLineStyle}"
                                                X1="1"
                                                X2="8"
                                                Y1="8.5"
                                                Y2="1.5" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="removeButton" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <TextBlock
            x:Name="dropText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            d:Visibility="Visible"
            FontFamily="Bahnschrift condensed"
            FontSize="24"
            Foreground="{DynamicResource Editor.Window.GrayBrush5}"
            IsHitTestVisible="False"
            Text="Drop Files Here">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource LightTextBlockStyle}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=Items.Count, ElementName=textureListBox}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <GridSplitter
            Width="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent" />
        <Border
            Grid.Column="1"
            Margin="0,0,5,0"
            Background="{DynamicResource Editor.Window.GrayBrush3}">
            <Grid
                d:DataContext="{d:DesignInstance Type={x:Type local:TextureProxy}}"
                d:Visibility="Visible"
                DataContext="{Binding Path=SelectedItem, ElementName=textureListBox}">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <Trigger Property="DataContext" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="10"
                    d:Text="Import settings for image.png"
                    FontSize="16"
                    Text="{Binding FileInfo.Name, StringFormat='Import settings for {0}'}"
                    TextTrimming="CharacterEllipsis" />
                <local:TextureImportSettingsView
                    Grid.Row="1"
                    Margin="10,0,10,28"
                    DataContext="{Binding ImportSettings}" />
                <Border
                    x:Name="lockBorder"
                    Grid.Row="1"
                    Margin="5,-5,5,23"
                    Background="#50000000"
                    BorderBrush="{DynamicResource Editor.FontBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    ToolTip="Import settings are locked when multiple sources are selected.&#13;Current settings can be applied to the selection."
                    ToolTipService.InitialShowDelay="100">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=textureListBox}" Value="1">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border
                        Width="16"
                        Height="12"
                        Margin="5,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Editor.FontBrush}"
                        CornerRadius="3"
                        Opacity="0.6">
                        <Border
                            Width="10"
                            Height="18"
                            Margin="0,-10,0,0"
                            BorderBrush="{DynamicResource Editor.FontBrush}"
                            BorderThickness="2,2,2,0"
                            CornerRadius="3,3,0,0">
                            <Rectangle
                                Width="3"
                                Height="5"
                                Margin="0,8,0,0"
                                Fill="{DynamicResource Editor.Window.GrayBrush2}" />
                        </Border>
                    </Border>
                </Border>
                <StackPanel
                    Grid.Row="2"
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Button
                        Width="150"
                        Click="OnApplyToSelection_Button_Click"
                        Content="Apply to Selection"
                        Visibility="{Binding Path=Visibility, ElementName=lockBorder}" />
                    <Button
                        Width="150"
                        Margin="0,8"
                        Click="OnApplyToAll_Button_Click"
                        Content="Apply to All" />
                    <Button Width="150" Content="Set as Default" />
                </StackPanel>
                <local:ChangeDestinationFolder
                    Grid.Row="3"
                    Margin="10,20,10,10"
                    VerticalAlignment="Top" />
                <Grid Grid.Row="4" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock
                            Margin="-2,3,0,10"
                            FontWeight="Bold"
                            Text="SOURCE IMAGES">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <Button
                            Margin="0,0,5,5"
                            Padding="0"
                            Click="OnAddImageSource_Button_Click"
                            Focusable="False"
                            ToolTip="Add selected images to image source list.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MooncastleButtonStyle}" TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=textureListBox}" Value="1">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="M0,0 L8,4 0,8 2,4 z" Style="{StaticResource ArrowPathStyle}" />
                        </Button>
                        <Button
                            Margin="0,0,5,5"
                            Padding="0"
                            Click="OnRemoveImageSource_Button_Click"
                            Focusable="False"
                            ToolTip="Remove selected image sources">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MooncastleButtonStyle}" TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=imageSourcesListBox}" Value="0">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="M0,4 L8,0 6,4 8,8 z" Style="{StaticResource ArrowPathStyle}" />
                        </Button>
                        <RepeatButton
                            Margin="0,10,5,5"
                            Padding="0"
                            Click="OnMoveSelectionUp_Button_Click"
                            Focusable="False"
                            ToolTip="Move up selected image sources">
                            <RepeatButton.Style>
                                <Style BasedOn="{StaticResource MooncastleButtonStyle}" TargetType="{x:Type RepeatButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=imageSourcesListBox}" Value="0">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RepeatButton.Style>
                            <Path Data="M0,8 L4,0 8,8 4,6 z" Style="{StaticResource ArrowPathStyle}" />
                        </RepeatButton>
                        <RepeatButton
                            Margin="0,0,5,5"
                            Padding="0"
                            Click="OnMoveSelectionDown_Button_Click"
                            Focusable="False"
                            ToolTip="Move down selected image sources">
                            <RepeatButton.Style>
                                <Style BasedOn="{StaticResource MooncastleButtonStyle}" TargetType="{x:Type RepeatButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedItems.Count, ElementName=imageSourcesListBox}" Value="0">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RepeatButton.Style>
                            <Path Data="M0,0 L4,2 8,0 4,8 z" Style="{StaticResource ArrowPathStyle}" />
                        </RepeatButton>
                    </StackPanel>
                    <ListBox
                        x:Name="imageSourcesListBox"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        AlternationCount="{Binding ImageSources.Count}"
                        ItemContainerStyle="{StaticResource AlternateColorListBoxItemStyle}"
                        ItemTemplate="{StaticResource ImageSourceListBoxItemTemplate}"
                        ItemsSource="{Binding ImageSources}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedIndex="0"
                        SelectionMode="Extended" />
                </Grid>
            </Grid>
        </Border>
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent" />
        <Grid Grid.Column="2" Background="{DynamicResource Editor.Window.GrayBrush3}">
            <Button
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="OnClearImportingItems_Button_Click"
                Content="Clear" />
            <DockPanel Margin="10">
                <TextBlock
                    DockPanel.Dock="Top"
                    FontSize="16"
                    Text="Imported files" />
                <local:ImportingItemsView Margin="0,10,0,0" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
