<Window
    x:Class="MooncastleEditor.Content.ConfigureImportSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MooncastleEditor.Content"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Configur eImport Settings"
    Width="1280"
    Height="800"
    d:DataContext="{d:DesignInstance Type={x:Type local:ConfigureImportSettings}}"
    Style="{StaticResource MooncastleWindowStyle}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <TabControl
            x:Name="tabControl"
            Background="Transparent"
            BorderThickness="0">
            <TabItem
                MinWidth="96"
                Header="Geometry"
                Tag="{x:Static local:AssetType.Mesh}">
                <local:ConfigureGeometryImportSettingsView />
            </TabItem>
            <TabItem
                MinWidth="96"
                Header="Texture"
                Tag="{x:Static local:AssetType.Texture}" />
            <TabItem
                MinWidth="96"
                Header="Audio"
                Tag="{x:Static local:AssetType.Audio}" />
        </TabControl>
    </Grid>
</Window>
